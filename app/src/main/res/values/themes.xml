<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      基础主题：必须用 API 9 就存在的原生主题。
      Theme.Light / Theme 在 API 11+ 会分别映射到 Holo Light / Holo，
      API 21+ 再映射到 Material Light / Material，外观随系统版本自然升级。
      界面自带顶栏，因此用 NoTitleBar。
    -->
    <style name="Theme.LanzouCloud" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/bg</item>
        <!-- 系统「强制深色」会反色我们自己的配色，这里关掉，深色由 App 自己控制 -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 深色主题：用户选「深色」或系统深色且为「跟随系统」时使用 -->
    <style name="Theme.LanzouCloud.Dark" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
